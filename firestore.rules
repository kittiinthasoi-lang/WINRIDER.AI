rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'kittiinthasoi@gmail.com' ||
        request.auth.token.email.matches('(?i).*kittiinthasoi.*')
      );
    }

    // 1. Transparent fee rules: anyone can read, authenticated can seed/update
    match /fee_rules/{ruleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Atomic system counters (e.g. foundingKnights)
    match /counters/{counterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. User profiles
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create: if request.auth != null;
    }

    // 4. Role Collections
    match /knights/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create: if request.auth != null;
    }

    match /citizens/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create: if request.auth != null;
    }

    match /merchants/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create: if request.auth != null;
    }

    match /partners/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create: if request.auth != null;
    }

    // 5. WALLETS (Sovereign Wallets)
    match /wallets/{walletId} {
      allow read: if request.auth != null && (request.auth.uid == walletId || walletId == 'SYSTEM_POOLS' || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // 6. LEDGER (Double-Entry Bookkeeping Journal)
    match /ledger/{entryId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /ledger_entries/{entryId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // 7. Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // 8. IDEMPOTENCY KEYS
    match /idempotency_keys/{key} {
      allow read, write: if isSuperAdmin();
    }

    // 9. PAYOUT REQUESTS
    match /payout_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // 10. Dispatch Rides & Trips
    match /rides/{rideId} {
      allow read, write: if request.auth != null;
    }
    match /trips/{tripId} {
      allow read, write: if request.auth != null;
    }

    // 11. LINE Bindings & Notifications
    match /line_bindings/{bindingId} {
      allow read, write: if request.auth != null;
    }

    // 12. Connection testing
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
