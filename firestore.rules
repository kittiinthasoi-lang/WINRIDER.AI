rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // ฟังก์ชันช่วยตรวจสอบว่าเป็นแอดมินหรือไม่
    // ใช้ custom claim "admin: true" ที่ตั้งผ่าน set-admin-claim.js
    // ---------------------------------------------------------------
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ป้องกันการ "สวมสิทธิ์" ตัวเอง: user ทั่วไปห้ามแตะ field ที่เกี่ยวกับ
    // สิทธิ์/สถานะในเอกสารของตัวเอง (isAdmin, role, adminLevel, status)
    // ต้องไม่มี field เหล่านี้อยู่ใน diff เลย ไม่ว่าจะเปลี่ยนหรือแค่ระบุค่าเดิมซ้ำ
    function noPrivilegeFieldsTouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isAdmin', 'role', 'adminLevel', 'status']);
    }

    // สำหรับ role collections: ห้ามเจ้าของเอกสารแก้ kycStatus เอง
    // ต้องผ่านขั้นตอน approveKyc/rejectKyc (Cloud Function) ที่แอดมินเป็นคนสั่งเท่านั้น
    function noKycFieldTouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['kycStatus']);
    }

    // 1. Transparent fee rules: anyone can read, authenticated can seed/update
    //    แอดมินแก้ไขได้เสมอ แม้ authenticated ทั่วไปจะแก้ได้ตามเดิม
    match /fee_rules/{ruleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Atomic system counters (e.g. foundingKnights)
    match /counters/{counterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. User profiles
    //    แอดมินอ่าน/แก้ไขข้อมูลของใครก็ได้ เพื่อจัดการระบบหลังบ้าน
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        // ตอนสร้างเอกสารใหม่ (สมัครสมาชิก) ห้ามให้ตั้งค่าตัวเองเป็นแอดมินตั้งแต่แรกเริ่ม
        && !('isAdmin' in request.resource.data)
        && !('role' in request.resource.data && request.resource.data.role == 'admin')
        && !('adminLevel' in request.resource.data);
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid && noPrivilegeFieldsTouched())
      );
    }

    // 4. Role Collections — แอดมินแก้ไขได้ทุกคน
    match /knights/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !('kycStatus' in request.resource.data && request.resource.data.kycStatus in ['verified', 'approved']);
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid && noKycFieldTouched())
      );
    }

    match /citizens/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null;
    }

    match /merchants/{uid} {
      allow read: if true;
      allow create: if request.auth != null && !('kycStatus' in request.resource.data && request.resource.data.kycStatus in ['verified', 'approved']);
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid && noKycFieldTouched())
      );
    }

    match /partners/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null;
    }

    // 5. WALLETS (Sovereign Wallets) - STRICTLY ADMIN SDK ONLY FOR WRITES
    //    Client อ่านได้เฉพาะ wallet ตัวเอง หรือแอดมินอ่านได้ทุก wallet
    //    การเขียนยังคงห้ามจาก client เด็ดขาด (ต้องผ่าน Cloud Function เท่านั้น)
    match /wallets/{walletId} {
      allow read: if request.auth != null && (request.auth.uid == walletId || walletId == 'SYSTEM_POOLS' || isAdmin());
      allow write: if false; // DIRECT CLIENT WRITING FORBIDDEN! Admin SDK & Cloud Functions only
    }

    // 6. LEDGER (Double-Entry Bookkeeping Journal) - STRICTLY ADMIN SDK ONLY FOR WRITES
    //    แอดมินอ่านได้ทุกรายการ เพื่อตรวจสอบ/ออดิต
    match /ledger/{entryId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.citizenId == request.auth.uid ||
        resource.data.knightId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // DIRECT CLIENT WRITING FORBIDDEN! Admin SDK & Cloud Functions only
    }

    match /ledger_entries/{entryId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.citizenId == request.auth.uid ||
        resource.data.knightId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // DIRECT CLIENT WRITING FORBIDDEN! Admin SDK & Cloud Functions only
    }

    // 7. IDEMPOTENCY KEYS - STRICTLY ADMIN SDK ONLY
    match /idempotency_keys/{key} {
      allow read, write: if false; // Internal Admin SDK & Cloud Functions only
    }

    // 8. PAYOUT REQUESTS - Callable Cloud Function only for writes
    //    แอดมินอ่านคำขอ payout ของทุกคนได้ เพื่อตรวจสอบ/อนุมัติผ่าน Cloud Function
    match /payout_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Must use requestPayout / adminApprovePayout callable Cloud Function
    }

    // 9. Dispatch Rides & Trips
    match /rides/{rideId} {
      allow read, write: if request.auth != null;
    }
    match /trips/{tripId} {
      allow read, write: if request.auth != null;
    }

    // 10. LINE Bindings & Notifications
    match /line_bindings/{bindingId} {
      allow read, write: if request.auth != null;
    }

    // 11. Connection testing
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
