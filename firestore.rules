rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.admin == true || request.auth.token.email == 'kittiinthasoi@gmail.com');
    }

    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'kittiinthasoi@gmail.com'
          || (request.auth.token.admin == true && request.auth.token.adminLevel == 'super')
        );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isRideParticipant() {
      return signedIn()
        && (
          resource.data.passengerUserId == request.auth.uid
          || resource.data.driverUserId == request.auth.uid
        );
    }

    // Fee configuration is public-read, admin-write only.
    match /fee_rules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System counters are not client-writable.
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Users can read/write only their own profile. Admins can manage profiles.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Driver profile.
    match /knights/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Passenger profile.
    match /citizens/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Merchant catalog is public-read; only the merchant owner/admin may write.
    match /merchants/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /partners/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Wallets are never client-writable.
    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || walletId == 'SYSTEM_POOLS' && isAdmin() || isAdmin();
      allow write: if isSuperAdmin();
    }

    // Ledger is server/admin controlled.
    match /ledger/{entryId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /ledger_entries/{entryId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Audit logs are immutable from the client.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
      allow update, delete: if false;
    }

    match /idempotency_keys/{key} {
      allow read, write: if isSuperAdmin();
    }

    // Payouts are created/processed by trusted backend code.
    match /payout_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isSuperAdmin();
    }

    // Top-up proofs and reference locks are server controlled. Users can read
    // only their own submission status; only admins can inspect the queue.
    match /topup_submissions/{submissionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /topup_references/{referenceHash} {
      allow read, write: if false;
    }

    // Rides are state-controlled by the trusted backend. Clients may read their own ride,
    // but cannot mutate status, driver assignment, fare, or financial fields directly.
    match /rides/{rideId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.passengerUserId == request.auth.uid
          || resource.data.driverUserId == request.auth.uid
        )
      );

      // Ride creation also goes through the trusted API so fare, coordinates,
      // service requirements and dispatch assignment cannot be forged by clients.
      allow create: if false;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Driver GPS is backend-ingested only; clients cannot forge or delete location history.
    match /rides/{rideId}/locations/{locationId} {
      allow read: if isAdmin() || (
        signedIn() && (
          get(/databases/$(database)/documents/rides/$(rideId)).data.passengerUserId == request.auth.uid
          || get(/databases/$(database)/documents/rides/$(rideId)).data.driverUserId == request.auth.uid
        )
      );
      allow write: if false;
    }

    match /trips/{tripId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.passengerUserId == request.auth.uid
          || resource.data.driverUserId == request.auth.uid
          || resource.data.citizenId == request.auth.uid
        )
      );
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // A user can manage only their own LINE binding. Admins can manage all.
    match /line_bindings/{bindingId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Connection-test collection is disabled in production.
    match /_connection_test/{docId} {
      allow read, write: if false;
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
