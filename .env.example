# WINRIDER.AI Environment Variables (Auto-configured with in-code fallback to firebase-applet-config.json)
# No mandatory environment variables required to run in preview

# Win Alert / TAT public data source
# WINRIDER.AI resolves the current JSON resource from TAT CKAN metadata at runtime.
# No hardcoded TAT resource URL is required.

# Wallet top-up recipient (server-side only)
ADMIN_PROMPTPAY_ID=
# Bank account used for WIN Wallet top-up (admin verifies each deposit before crediting)
ADMIN_BANK_NAME=ธนาคารกสิกรไทย
ADMIN_BANK_ACCOUNT_NUMBER=
ADMIN_BANK_ACCOUNT_NAME=
# Email that is always treated as the application owner / Super Admin
ADMIN_OWNER_EMAIL=
# Firebase Configuration & Firestore Database ID
FIRESTORE_DATABASE_ID=ai-studio-winriderai-96f1b3b6-26ee-4fca-ba51-662b278eea8d
FIREBASE_PROJECT_ID=decoded-robot-6lkcn
VITE_FIREBASE_PROJECT_ID=decoded-robot-6lkcn
# Firebase Admin Storage bucket used for private top-up proof images
FIREBASE_STORAGE_BUCKET=decoded-robot-6lkcn.firebasestorage.app
# Firebase Web Client Storage bucket used for payment QR uploads
VITE_FIREBASE_STORAGE_BUCKET=decoded-robot-6lkcn.firebasestorage.app


# Optional internal scheduler secret for source-driven TAT synchronization
# Store the same value in the production server and GitHub Actions secret TAT_INTERNAL_SYNC_SECRET.
TAT_INTERNAL_SYNC_SECRET=

# Payment provider production integration
# Never commit real values. Provider/proxy must sign stable-canonical JSON with HMAC-SHA256.
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_PROVIDER_REFUND_URL=
PAYMENT_PROVIDER_API_TOKEN=
PAYMENT_PROVIDER_ALLOWED_HOST=

# Firebase web config (set in deployment environment)
VITE_FIREBASE_API_KEY=

# WIN Alert public-data synchronization
WIN_ALERT_INTERNAL_SYNC_SECRET=

# Public location / AI architecture
# Maps/Places/Routes use no paid provider API key. Navigation opens external apps.
# WIN-AI uses external handoff; no Gemini/OpenAI provider key is stored here.
