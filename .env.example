VITE_SUPABASE_ANON_KEY=
# Server-only values. Never prefix secret/service-role keys with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server secret fallback.
SUPABASE_SERVICE_ROLE_KEY=
