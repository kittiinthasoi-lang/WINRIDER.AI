# WINRIDER.AI Environment Variables (Auto-configured with in-code fallback to firebase-applet-config.json)
# No mandatory environment variables required to run in preview

# Real nearby events (server-side only; never expose this token with a VITE_ prefix)
# Create an Events API access token in PredictHQ, then configure the same key in production.
PREDICTHQ_ACCESS_TOKEN=

# Google Maps Platform
# FREE-ONLY MODE: these keys are intentionally unused by WINRIDER.AI.
# Do not add paid Google Maps/Places keys to production unless the source-level free-only lock is deliberately changed.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Wallet top-up recipient (server-side only)
ADMIN_PROMPTPAY_ID=
# Bank account used for WIN Wallet top-up (admin verifies each deposit before crediting)
ADMIN_BANK_NAME=ธนาคารกสิกรไทย
ADMIN_BANK_ACCOUNT_NUMBER=
ADMIN_BANK_ACCOUNT_NAME=
# Email that is always treated as the application owner / Super Admin
ADMIN_OWNER_EMAIL=
# Required by WIN-AI and AI slip screening (server-side only)
GEMINI_API_KEY=

# Firebase Configuration & Firestore Database ID
FIRESTORE_DATABASE_ID=ai-studio-winriderai-96f1b3b6-26ee-4fca-ba51-662b278eea8d
FIREBASE_PROJECT_ID=decoded-robot-6lkcn
VITE_FIREBASE_PROJECT_ID=decoded-robot-6lkcn
# Firebase Admin Storage bucket used for private top-up proof images
FIREBASE_STORAGE_BUCKET=decoded-robot-6lkcn.firebasestorage.app
# Firebase Web Client Storage bucket used for payment QR uploads
VITE_FIREBASE_STORAGE_BUCKET=decoded-robot-6lkcn.firebasestorage.app

